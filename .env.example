# Copy this file to .env and fill in your credentials

# ── Server Config ──────────────────────────────
HA_DRIVER=mock
# HA_DRIVER=anthropic
# HA_DRIVER=openai
# HA_DRIVER=deepseek
# HA_DRIVER=zhipu
# HA_DRIVER=qwen
# HA_DRIVER=ollama

# HA_MODEL=claude-opus-4-6
# HA_PORT=8000
# HA_CORES=4
# HA_SKILLS_DIR=./skills

# ── API Auth ───────────────────────────────────
# Set to enable API key authentication (leave empty to disable)
# HA_API_KEY=your-secret-api-key

# ── LLM API Keys ──────────────────────────────
# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxxx
# ANTHROPIC_BASE_URL=https://your-proxy.example.com/v1

# OpenAI
# OPENAI_API_KEY=sk-xxxxx

# DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxx

# Zhipu (GLM)
# ZHIPU_API_KEY=xxxxx

# Qwen (DashScope)
# DASHSCOPE_API_KEY=sk-xxxxx
